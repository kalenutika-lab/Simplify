{
  "name": "personal-project-manager",
  "version": "1.5.1",
  "private": true,
  "description": "Local-first personal project manager (installable web app).",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js 8080",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/local-notifications": "8.3.1"
  }
}
